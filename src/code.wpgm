import wollok.game.*
import messi.*
import barraEmocional.*
import recolectables.*
import gestionDeNiveles.*
import estados.*
import pantallas.*
import musica.*

program juego {
  game.title("Messi Game")
  game.width(16)
  game.height(9)
  game.cellSize(60)
  game.boardGround("board.png")
  reproductorMusical.iniciarMusicaFondo()

  
  pantallaMenu.mostrar()

  game.start()
}